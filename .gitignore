# Build output
/build/

# FPC compiler artifacts (in case units are built in-tree)
*.o
*.ppu
*.a
*.rsj
*.or
*.res
*.compiled

# Vendored SQLite amalgamation (fetched by scripts/fetch-sqlite.sh)
/deps/sqlite3/sqlite3.c
/deps/sqlite3/sqlite3.h
/deps/sqlite3/sqlite3ext.h

# Vendored mbedTLS source (fetched by scripts/fetch-mbedtls.sh)
# No trailing slash: `worktree-add.sh` shares these as SYMLINKS, and a pattern
# ending in `/` matches only a real directory, so the links showed as untracked
# in every worktree.
/deps/mbedtls

# Vendored CA bundle -- COMMITTED, not fetched.
# curl.se/ca/cacert.pem is a ROLLING url: any pinned hash of it breaks every
# fresh clone the moment a root is rotated, which is exactly what happened. The
# bundle is 188 KB and changes a few times a year, so it is tracked to keep the
# build hermetic and offline. Refresh it deliberately with
# `scripts/fetch-cacert.sh --update`.

# Local secrets and environment overrides
.env
.env.local
.env.*.local

# Machine-specific notes (absolute paths, external checkout locations).
# Never committed: this repo must not leak the operator's home directory.
/LOCAL_NOTES.md

# Lazarus / IDE
backup/
*.lps
*.lpi.local

# Editors / OS
.DS_Store
*.swp
*~

# Parallel agent playgrounds (git worktrees)
.worktrees/
