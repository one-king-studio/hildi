# Copy to .env and fill in. Loaded by the agent CLI; existing shell variables win.
HILDEGARD_LLM_ENDPOINT=https://api.fireworks.ai/inference/v1/chat/completions
HILDEGARD_LLM_MODEL=accounts/fireworks/models/your-model-here
HILDEGARD_LLM_API_KEY=your-api-key-here
# HILDEGARD_SYSTEM_PROMPT=
# HILDEGARD_STORE_PATH=~/.hildegard-helper/store.db   # enables the shell tool
# HILDEGARD_MAX_CONTEXT_TOKENS=1000000   # override the loop's 120k context guard
# NO_COLOR=1
