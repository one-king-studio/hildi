# Copy to .env and fill in. Loaded by the agent CLI; existing shell variables win.
HILDI_LLM_ENDPOINT=https://api.fireworks.ai/inference/v1/chat/completions
HILDI_LLM_MODEL=accounts/fireworks/models/your-model-here
HILDI_LLM_API_KEY=your-api-key-here
# HILDI_SYSTEM_PROMPT=
# HILDI_STORE_PATH=~/.hildi/store.db   # enables the shell tool
# HILDI_MAX_CONTEXT_TOKENS=1000000   # override the loop's 120k context guard
# HILDI_COMMAND_TIMEOUT_MS=600000    # optional cap on run_command timeout_ms (unset = the model decides)
# HILDI_RUNTIME_BIN=                  # headless agent binary the TUI spawns (else a sibling of the TUI)
# NO_COLOR=1
