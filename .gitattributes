# Normalise line endings on checkout so a fork on Windows does not produce a
# whole-tree diff, and so shell scripts keep working.
* text=auto eol=lf

# Pascal source
*.pas text eol=lf
*.pp  text eol=lf
*.inc text eol=lf
*.lpr text eol=lf

# C shim
*.c   text eol=lf
*.h   text eol=lf

# Shell scripts must stay executable and LF
*.sh  text eol=lf

# Docs and config
*.md  text eol=lf
Makefile text eol=lf
*.example text eol=lf

# Byte-exact test fixture. This document MUST keep its CRLF line endings: it is
# the corpus document that exercises CRLF handling, so normalising it to LF
# silently stops the test testing CRLF. Marked binary so git compares it
# byte-for-byte and never rewrites it on checkout.
tests/data/md_corpus/10_crlf.md binary

# Binary-ish
*.a   binary
*.o   binary
*.ppu binary
*.db  binary
